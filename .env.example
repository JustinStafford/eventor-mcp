# Which Eventor to talk to: au (default), se, no, iof
EVENTOR_INSTANCE=au
# Or point at any Eventor API root directly (overrides EVENTOR_INSTANCE)
# EVENTOR_BASE_URL=https://eventor.orienteering.asn.au/api/

# Your club's API key (Eventor > Organisation admin > API key)
EVENTOR_API_KEY=

# Optional: a personal Eventor login, for authenticate_person and organiser endpoints
EVENTOR_USERNAME=
EVENTOR_PASSWORD=

# Optional tuning
# EVENTOR_CACHE_TTL_SECONDS=300
# EVENTOR_MAX_RESPONSE_CHARS=200000
# EVENTOR_READ_ONLY=false
# EVENTOR_EXCLUDE_TOOLS=eventor_get,get_external_login_url
