{
  "name": "eventor-mcp",
  "version": "0.2.0",
  "description": "MCP server covering the full Eventor orienteering API (Australia, Sweden, Norway, IOF)",
  "type": "module",
  "bin": {
    "eventor-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "eventor",
    "orienteering",
    "model-context-protocol"
  ],
  "author": "Justin Stafford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinStafford/eventor-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
